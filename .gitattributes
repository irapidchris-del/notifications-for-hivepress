# Keep development-only files out of GitHub's generated source archive, so that even if a release
# has no attached asset and the updater falls back to the source zip, users still get a clean
# plugin. The release asset built by bin/build-release.sh is the primary distribution.
/.gitattributes   export-ignore
/.gitignore       export-ignore
/.github          export-ignore
/bin              export-ignore
/dist             export-ignore
/phpcs.xml        export-ignore
/RELEASING.md     export-ignore
