#: includes/forms/class-hpnf-notification-update.php:59
msgid "Texts apply only where an event has an SMS message set up."
msgstr ""

#: includes/forms/class-hpnf-notification-update.php:127
msgid "Quiet Hours"
msgstr ""

#: includes/forms/class-hpnf-notification-update.php:128
msgid "No pop-ups, push notifications or text messages between these times. Anything with an on-site notification still waits in your list. Set both the same to switch this off."
msgstr ""

#: includes/forms/class-hpnf-notification-update.php:137
msgid "Until"
msgstr ""

#: includes/forms/class-hpnf-notification-update.php:147
msgid "Choose how you want to hear about each of these. Clear every box in a group to disable that kind of notification altogether."
msgstr ""

#: includes/forms/class-hpnf-notification-update.php:148
msgid "Your notification settings have been saved."
